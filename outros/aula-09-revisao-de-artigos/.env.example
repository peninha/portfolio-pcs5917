# Triagem com o Jev da TypeSafe pela Decisions API do OpenRouter.
# OPENROUTER_JEV_API_KEY=
# OPENROUTER_JEV_MODEL=typesafe/jev-1.14

# Provedor compartilhado pelo ensemble e pela síntese. Inclua /v1 se fizer parte do endereço.
# REVIEW_API_BASE_URL=
# Chave do provedor compartilhado, quando exigida.
# REVIEW_API_KEY=
# Modelo padrão da síntese e da triagem alternativa por LLM.
# REVIEW_MODEL=
# Modelo da triagem alternativa por LLM quando o Jev estiver desativado.
# REVIEW_MODEL_JEV=
# Três modelos distintos do ensemble. Estes são os padrões na API direta da OpenAI.
# REVIEW_MODEL_AVALIADOR_1=gpt-5.4-mini
# REVIEW_MODEL_AVALIADOR_2=gpt-5.4
# REVIEW_MODEL_AVALIADOR_3=gpt-5.5
# REVIEW_MODEL_SINTESE=

# Esforço opcional. Se omitido, vale o padrão do modelo.
# REVIEW_REASONING_EFFORT=medium
# REVIEW_REASONING_EFFORT_JEV=low
# REVIEW_REASONING_EFFORT_ENSEMBLE=medium
# REVIEW_REASONING_EFFORT_SINTESE=

# REVIEW_PORT=4399
